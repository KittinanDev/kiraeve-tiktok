{
  "name": "kiraeve-tiktok",
  "version": "1.0.4",
  "description": "Kiraeve TikTok — Live Studio & Overlays Manager (Electron Desktop App)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "release": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.kiraeve.tiktok",
    "productName": "Kiraeve TikTok",
    "files": [
      "main.js",
      "preload.js",
      "icons/**/*"
    ],
    "extraResources": [
      { "from": "build/install-prereqs.bat", "to": "app/install-prereqs.bat" },
      { "from": "server.py",             "to": "app/server.py" },
      { "from": "dashboard.html",        "to": "app/dashboard.html" },
      { "from": "overlay.html",          "to": "app/overlay.html" },
      { "from": "overlay_auction.html",  "to": "app/overlay_auction.html" },
      { "from": "overlay_gacha.html",    "to": "app/overlay_gacha.html" },
      { "from": "overlay_jar.html",      "to": "app/overlay_jar.html" },
      { "from": "overlay_leaderboard.html","to": "app/overlay_leaderboard.html" },
      { "from": "overlay_timer.html",    "to": "app/overlay_timer.html" },
      { "from": "overlay_tts.html",      "to": "app/overlay_tts.html" },
      { "from": "tiktok_connector.js",   "to": "app/tiktok_connector.js" },
      { "from": "config.json",           "to": "app/config.json" },
      { "from": "gift_cache.json",       "to": "app/gift_cache.json" },
      { "from": "gift_catalog_cache.json","to": "app/gift_catalog_cache.json" },
      { "from": "requirements.txt",      "to": "app/requirements.txt" },
      { "from": "media",                 "to": "app/media" },
      { "from": "Soundeffect",           "to": "app/Soundeffect" }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/app.ico"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kiraeve TikTok",
      "installerIcon": "icons/app.ico",
      "uninstallerIcon": "icons/app.ico",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KittinanDev",
        "repo": "kiraeve-tiktok",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "tiktok-live-connector": "^2.4.4"
  }
}
